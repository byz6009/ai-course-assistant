# Export these variables in the BACKEND process environment. This file is documentation,
# not loaded automatically. Never use a VITE_ prefix for secrets.
# Prefer the in-app AI settings page for interactive setup; saved local settings take precedence.
# Use the provider's Base URL (with /v1 only when required), or a full /chat/completions URL.
KEJI_AI_BASE_URL=https://your-provider.example/v1
KEJI_AI_MODEL=your-model-name
KEJI_AI_API_KEY=replace-locally
# Optional absolute Python executable path for npm scripts:
# KEJI_PYTHON=C:\Python312\python.exe
